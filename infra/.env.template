# ============================================================================
# Nexus AI MDM — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5433

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_DISABLED=false
API_BEARER_TOKEN=generate_a_secure_token_here

# ── Field-level PII encryption (AES-256-GCM) ─────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes / 256 bits).
# If not set, PII attributes (email, phone, tax_id) are stored plaintext.
FIELD_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# ── Ollama / AI ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.2:8b
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Environment ──────────────────────────────────────────────────────────────
# Set to 'production' or 'staging' to enable security guards:
#   - ALLOWED_ORIGINS must NOT contain 'localhost' (service refuses to start)
#   - FIELD_ENCRYPTION_KEY must be set (logs a warning if missing)
APP_ENV=development

# ── Distributed Tracing (OpenTelemetry OTLP) ─────────────────────────────────
# Points to Grafana Tempo in Docker Compose. Leave empty to disable OTLP export.
# For production, set to your Tempo / Jaeger / OTLP collector endpoint.
#   gRPC (port 4317): http://tempo:4317
#   HTTP (port 4318): http://tempo:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_TRACING=true
RUST_LOG=info
